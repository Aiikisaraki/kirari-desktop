{
    "name": "akisaki-kirari",
    "private": true,
    "version": "0.8.0",
    "main": "dist-electron/main.js",
    "scripts": {
        "dev": "chcp 65001 && vite",
        "build": "chcp 65001 && vite build",
        "preview": "chcp 65001 && vite preview",
        "electron:dev": "chcp 65001 && vite",
        "write-edition-nsh": "node scripts/write-edition-nsh.cjs integrated",
        "pack": "npm run write-edition-nsh && electron-builder --dir --config electron-builder.yml",
        "dist": "npm run build && npm run write-edition-nsh && electron-builder --config electron-builder.yml --publish=never",
        "typecheck": "vue-tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.electron.json",
        "test": "vitest run",
        "test:watch": "vitest"
    },
    "dependencies": {
        "@types/katex": "^0.16.8",
        "@vue/devtools-api": "^8.1.5",
        "@vue/devtools-kit": "^8.2.1",
        "@vue/devtools-shared": "^8.2.1",
        "bcryptjs": "^3.0.3",
        "better-sqlite3": "^13.0.3",
        "birpc": "^2.6.1",
        "dompurify": "^3.4.12",
        "extract-zip": "^2.0.1",
        "hookable": "^5.5.3",
        "katex": "^0.18.1",
        "kirari-net": "file:../kirari-net",
        "marked": "^18.0.7",
        "nostics": "^1.1.4",
        "openai": "^7.31.0",
        "perfect-debounce": "^2.0.0",
        "pinia": "^4.0.2",
        "qrcode": "^1.5.4",
        "vue": "^3.5.34",
        "ws": "^8.22.0"
    },
    "devDependencies": {
        "@types/better-sqlite3": "^9.6.0",
        "@types/node": "^24.12.3",
        "@types/qrcode": "^1.5.6",
        "@types/ws": "^8.18.2",
        "@vitejs/plugin-vue": "^6.0.6",
        "@vue/test-utils": "^2.5.1",
        "@vue/tsconfig": "^0.9.1",
        "electron": "^42.7.0",
        "electron-builder": "^26.0.12",
        "happy-dom": "^20.14.6",
        "typescript": "~6.0.2",
        "vite": "^8.0.12",
        "vite-plugin-electron": "^1.0.4",
        "vitest": "^5.0.3",
        "vue-tsc": "^3.2.8"
    }
}
