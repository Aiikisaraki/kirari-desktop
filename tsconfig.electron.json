{
  "extends": "./tsconfig.node.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.electron.tsbuildinfo",
    // 主进程此前从未被类型检查覆盖过（只有 vite 打包，不做检查）。现在让它进来，
    // 未使用检查也一并打开：当初暴露出来的那几处已经处理干净 ——
    //   - leafClient 的 hostId / hostName / hostSalt 只赋值没人读 → 已删
    //   - handshakeTimeout() 从未被调用 → 已接上（open 之后改用它，见 protocol.ts）
    //   - manager.ts 两个未使用的 type import → 已删
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": ["electron/**/*.ts"]
}
